{
  "name": "@runezone/rune-types",
  "version": "0.1.0",
  "description": "Core shared types, constants, and DI symbols for the RuneZone Shared SDK. Layer 0 — zero runtime dependencies.",
  "keywords": [
    "runezone",
    "types",
    "sdk",
    "contracts",
    "shared-sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist coverage",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@runezone/eslint-config": "workspace:*",
    "@runezone/prettier-config": "workspace:*",
    "@runezone/tsconfig": "workspace:*",
    "@runezone/vitest-config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
