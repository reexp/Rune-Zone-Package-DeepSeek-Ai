{
  "name": "runezone-shared-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "RuneZone Shared SDK — Enterprise-grade shared packages for the RuneZone ecosystem (CMS, Dashboard, Web, Mobile, Workers, CLI, API SDK).",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "clean": "pnpm -r clean && rimraf node_modules dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml}\"",
    "check:deps": "node scripts/check-circular-deps.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "pnpm -r publish --access public",
    "publish:packages": "changeset publish",
    "prepare": "husky"
  },
  "keywords": [
    "runezone",
    "sdk",
    "shared-sdk",
    "monorepo",
    "cms",
    "nextjs",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@eslint/js": "^9.24.0",
    "@runezone/prettier-config": "workspace:*",
    "@runezone/tsconfig": "workspace:*",
    "@runezone/vitest-config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.0"
  }
}
